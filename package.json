{
  "name": "drum-synth-js",
  "version": "1.0.0",
  "description": "Dependency-free configurable drum synthesis, Web Audio playback and WAV export",
  "type": "module",
  "main": "./src/drum-synth.js",
  "types": "./src/drum-synth.d.ts",
  "exports": {".": {"types": "./src/drum-synth.d.ts", "import": "./src/drum-synth.js"}},
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {"test": "node --test", "start": "node scripts/serve.mjs", "samples": "node scripts/render-samples.mjs", "check": "node --check src/drum-synth.js && node --check demo/demo.js"},
  "engines": {"node": ">=20"},
  "keywords": ["drum", "synthesizer", "web-audio", "percussion", "wav"],
  "license": "MIT"
}
